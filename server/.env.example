# Caminho do arquivo SQLite. Relativo à pasta prisma/.
DATABASE_URL="file:./dev.db"

# Porta da API. A Railway injeta a dela automaticamente — não defina lá.
PORT=3333

# Domínios liberados no CORS, separados por vírgula.
# Em produção, coloque aqui a URL da Vercel.
CORS_ORIGIN="http://localhost:5173"
